# E2E Test Environment Configuration
# Copy to .env.e2e.local and fill in values

# Required: LLM provider credentials (at least one)
# ANTHROPIC_OAUTH_TOKEN=
# OPENROUTER_API_KEY=

# Log level for tests
RUST_LOG=debug

# Test timeouts (seconds)
E2E_DEFAULT_TIMEOUT=60
E2E_LONG_TIMEOUT=300

# Test workspace (auto-created, auto-cleaned)
# E2E_WORKSPACE=/tmp/rustyclaw_e2e

# Elixir bridge
# E2E_BRIDGE_ENABLED=true
